APP_ENV=development
DATABASE_URL=sqlite:///./jee_mentor.db
FRONTEND_ORIGIN=http://localhost:5173

# Microsoft Foundry Agent Service
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_ID=

# Foundry IQ / Azure AI Search knowledge base API
FOUNDRY_IQ_ENDPOINT=
FOUNDRY_IQ_API_KEY=
FOUNDRY_IQ_KNOWLEDGE_BASE_ID=

# Optional OCR. Tesseract must also be installed on the host.
TESSERACT_CMD=
